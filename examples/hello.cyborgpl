fn add(a: num, b: num) -> num {
    return 'a' + 'b';
}

START
    var:num 'first' = 5;
    var:num 'second' = 2.5;
    if 'first' < 'second' {
        print*add('first', 'second')*;
    } else {
        print*0*;
    }

    var:str 'greeting' = "hello, cyborgpl";
    print*'greeting'*;

    var:num 'i' = 0;
    while 'i' < 3 {
        print*'i'*;
        'i' = 'i' + 1;
    }
END
