START

var:str 'name' = ("John Doe");
var:file 'x' = ("/tmp/cyborgpl_storage_example.txt");
print*(ref:var:str 'name')* [to*(ref:var:file 'x')*];

overwrite*"hello world"* [to*("/tmp/cyborgpl_storage_example2.txt")*];

print*"both files written -- this line still goes to the screen"*;
print*"Hello, World!"*;

END
